              "left": 60,
              "top": 45,
              "width": 880,
              "height": 50,
              "content": "<p style=\"font-size: 26px;\"><strong>Business case practice</strong></p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#1a3a5c",
              "rotate": 0
            },
            {
              "id": "shape_a1wNxs34ed_case_box",
              "type": "shape",
