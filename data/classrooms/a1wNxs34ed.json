            {
              "id": "text_a1wNxs34ed_explain",
              "type": "text",
              "left": 540,
              "top": 145,
              "width": 370,
              "height": 300,
              "content": "<p style=\"font-size: 20px;\"><strong>How to use these terms</strong></p><p style=\"font-size: 17px;\">Do not only memorize the word. In LAN110, define it, connect it to a company situation, and explain why it matters for decision-making.</p><p style=\"font-size: 17px;\"><strong>Useful sentence frame: “This matters because…”</strong></p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#334155",
              "rotate": 0
            }
          ],
