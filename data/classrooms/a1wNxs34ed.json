        },
        {
          "id": "action_scene_a1wNxs34ed_2_language_speech_0",
          "type": "speech",
          "text": "Let us build the vocabulary first. These are the terms you should be able to define without hesitation.",
          "audioId": "tts_s2_action_scene_a1wNxs34ed_2_language_speech_0",
          "audioUrl": "https://academy.linguistic-communication.com/api/classroom-media/a1wNxs34ed/audio/tts_s2_action_scene_a1wNxs34ed_2_language_speech_0.mp3",
          "voice": "Daniel (macOS generated MP3)"
        },
        {
          "id": "action_scene_a1wNxs34ed_2_language_spot_1",
          "type": "spotlight",
          "elementId": "shape_a1wNxs34ed_terms_box"
        },
        {
          "id": "action_scene_a1wNxs34ed_2_language_speech_1",
          "type": "speech",
          "text": "A strong LAN110 answer does more than translate a word. It explains the role of the term in a company situation.",
          "audioId": "tts_s2_action_scene_a1wNxs34ed_2_language_speech_1",
          "audioUrl": "https://academy.linguistic-communication.com/api/classroom-media/a1wNxs34ed/audio/tts_s2_action_scene_a1wNxs34ed_2_language_speech_1.mp3",
          "voice": "Daniel (macOS generated MP3)"
        },
        {
          "id": "action_scene_a1wNxs34ed_2_language_spot_2",
          "type": "spotlight",
          "elementId": "text_a1wNxs34ed_terms"
        },
        {
          "id": "action_scene_a1wNxs34ed_2_language_speech_2",
          "type": "speech",
          "text": "Use a sentence such as: this matters because. That forces you to connect vocabulary to business meaning.",
          "audioId": "tts_s2_action_scene_a1wNxs34ed_2_language_speech_2",
          "audioUrl": "https://academy.linguistic-communication.com/api/classroom-media/a1wNxs34ed/audio/tts_s2_action_scene_a1wNxs34ed_2_language_speech_2.mp3",
