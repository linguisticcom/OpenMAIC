            {
              "id": "text_IskV0Dxi",
              "type": "text",
              "left": 560,
              "top": 440,
              "width": 360,
              "height": 24,
              "content": "<p style=\"font-size: 16px;\"><b>NPV ≈ +€36,776</b>  →  Value created!</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#2b7a4b",
              "rotate": 0
            },
            {
              "id": "shape_mMmwbIYj",
              "type": "shape",
              "left": 60,
              "top": 460,
              "width": 880,
              "height": 70,
              "path": "M 0 0 L 1 0 L 1 1 L 0 1 Z",
              "viewBox": [
