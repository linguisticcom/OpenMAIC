              "type": "text",
              "left": 90,
              "top": 145,
              "width": 330,
              "height": 305,
              "content": "<p style=\"font-size: 17px;\">• stakeholder</p><p style=\"font-size: 17px;\">• financial reporting</p><p style=\"font-size: 17px;\">• corporate finance</p><p style=\"font-size: 17px;\">• evidence</p><p style=\"font-size: 17px;\">• decision usefulness</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#1e293b",
              "rotate": 0
            },
            {
              "id": "shape_a1wNxs34ed_explain_box",
              "type": "shape",
              "left": 510,
