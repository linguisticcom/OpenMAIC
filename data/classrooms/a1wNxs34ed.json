            {
              "id": "text_a1wNxs34ed_takeaway",
              "type": "text",
              "left": 90,
              "top": 155,
              "width": 820,
              "height": 65,
              "content": "<p style=\"font-size: 19px;\"><strong>LAN110 is not just vocabulary: every term must help you explain a business situation clearly and professionally.</strong></p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#14532d",
              "rotate": 0
            },
            {
              "id": "text_a1wNxs34ed_prep",
              "type": "text",
              "left": 60,
              "top": 285,
              "width": 880,
              "height": 155,
              "content": "<p style=\"font-size: 20px;\"><strong>Before moving on</strong></p><p style=\"font-size: 17px;\">• Say the key definitions aloud in business English.</p><p style=\"font-size: 17px;\">• Write one short paragraph applying the terms to the case.</p><p style=\"font-size: 17px;\">• Check that your answer includes a consequence, not only a definition.</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#1f2937",
