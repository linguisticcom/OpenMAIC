              "rotate": 0
            },
            {
              "id": "text_mBTts6QK",
              "type": "text",
              "left": 80,
              "top": 478,
              "width": 840,
              "height": 46,
              "content": "<p style=\"font-size: 18px; text-align: center;\"><b>Decision Rule:</b> Accept if NPV &gt; 0  |  Reject if NPV &lt; 0</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#1a3a5c",
              "rotate": 0
            }
          ],
          "background": {
            "type": "solid",
