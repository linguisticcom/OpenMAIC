            {
              "id": "text_lan110_module_12_terms",
              "type": "text",
              "left": 90,
              "top": 145,
              "width": 330,
              "height": 305,
              "content": "<p style=\"font-size: 17px;\">• definition</p><p style=\"font-size: 17px;\">• report structure</p><p style=\"font-size: 17px;\">• evidence</p><p style=\"font-size: 17px;\">• example</p><p style=\"font-size: 17px;\">• recommendation</p><p style=\"font-size: 17px;\">• clarity</p><p style=\"font-size: 17px;\">• coherence</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#1e293b",
              "rotate": 0
            },
            {
              "id": "shape_lan110_module_12_explain_box",
              "type": "shape",
              "left": 510,
