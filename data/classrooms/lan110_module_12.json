            "question": "What makes a strong short finance report?",
            "options": [
              {
                "value": "A",
                "label": "A list of disconnected definitions"
              },
              {
                "value": "B",
                "label": "Clear structure, accurate terms, evidence, and a practical conclusion"
              },
              {
                "value": "C",
                "label": "Only formulas with no explanation"
              },
              {
                "value": "D",
                "label": "Informal opinion without support"
              }
            ],
            "answer": [
              "B"
            ],
            "analysis": "A strong report combines structure, accurate vocabulary, evidence, application, and a concise conclusion.",
            "points": 10,
            "hasAnswer": true
          }
