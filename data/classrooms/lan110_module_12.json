      "actions": [
        {
          "id": "action_scene_lan110_module_12_2_language_spot_0",
          "type": "spotlight",
          "elementId": "text_lan110_module_12_terms_title"
        },
        {
          "id": "action_scene_lan110_module_12_2_language_speech_0",
          "type": "speech",
          "text": "Let us build the vocabulary first. These are the terms you should be able to define without hesitation."
        },
        {
          "id": "action_scene_lan110_module_12_2_language_spot_1",
          "type": "spotlight",
          "elementId": "shape_lan110_module_12_terms_box"
        },
        {
          "id": "action_scene_lan110_module_12_2_language_speech_1",
          "type": "speech",
          "text": "A strong LAN110 answer does more than translate a word. It explains the role of the term in a company situation."
        },
        {
          "id": "action_scene_lan110_module_12_2_language_spot_2",
          "type": "spotlight",
          "elementId": "text_lan110_module_12_terms"
        },
        {
          "id": "action_scene_lan110_module_12_2_language_speech_2",
          "type": "speech",
          "text": "Use a sentence such as: this matters because. That forces you to connect vocabulary to business meaning."
        }
      ],
      "createdAt": 1783202700002,
      "updatedAt": 1783202700002
