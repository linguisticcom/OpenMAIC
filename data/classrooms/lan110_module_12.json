            {
              "id": "text_lan110_module_12_outcomes",
              "type": "text",
              "left": 60,
              "top": 265,
              "width": 880,
              "height": 160,
              "content": "<p style=\"font-size: 20px;\"><strong>Learning outcomes</strong></p><p style=\"font-size: 16px;\">• Prepare concise definitions of key LAN110 terms</p><p style=\"font-size: 16px;\">• Structure a 300-word financial reporting answer</p><p style=\"font-size: 16px;\">• Use evidence, examples, and clear transitions in assessment writing</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#1f2937",
              "rotate": 0
            },
            {
