          "audioUrl": "https://academy.linguistic-communication.com/api/classroom-media/lan110_module_03/audio/tts_s2_action_scene_lan110_module_03_2_language_speech_1.mp3",
          "voice": "Daniel (macOS generated MP3)"
        },
        {
          "id": "action_scene_lan110_module_03_2_language_spot_2",
          "type": "spotlight",
          "elementId": "text_lan110_module_03_terms"
        },
        {
          "id": "action_scene_lan110_module_03_2_language_speech_2",
          "type": "speech",
          "text": "Use a sentence such as: this matters because. That forces you to connect vocabulary to business meaning.",
