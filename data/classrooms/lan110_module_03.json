      "id": "scene_lan110_module_03_4_quiz",
      "stageId": "lan110_module_03",
      "type": "quiz",
      "title": "Quick Check: Capital, shares, creditors, and venture finance",
      "order": 4,
      "content": {
        "type": "quiz",
        "questions": [
          {
            "id": "q1",
            "type": "single",
            "question": "Which statement best describes equity finance?",
            "options": [
              {
                "value": "A",
                "label": "It creates fixed interest payments to a bank"
              },
              {
                "value": "B",
                "label": "It raises money by giving investors ownership claims"
              },
              {
                "value": "C",
                "label": "It is always cheaper than debt"
              },
              {
                "value": "D",
                "label": "It eliminates the need for reporting"
              }
            ],
            "answer": [
              "B"
            ],
            "analysis": "Equity finance raises funds by issuing ownership claims, usually shares. It may reduce repayment pressure but dilutes ownership and changes governance.",
            "points": 10,
            "hasAnswer": true
          }
        ]
      },
      "actions": [
        {
          "id": "action_lan110_module_03_quiz_intro",
          "type": "speech",
          "text": "Now test your understanding of capital, shares, creditors, and venture finance. Choose the answer that best fits the business situation.",
