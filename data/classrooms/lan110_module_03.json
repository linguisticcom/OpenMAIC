            {
              "id": "text_lan110_module_03_case",
              "type": "text",
              "left": 90,
              "top": 145,
              "width": 820,
              "height": 85,
              "content": "<p style=\"font-size: 18px;\">A technology company needs €2 million to expand and must decide whether to issue shares, borrow from a bank, or approach venture-capital investors.</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#431407",
              "rotate": 0
            },
            {
              "id": "text_lan110_module_03_steps",
              "type": "text",
              "left": 60,
              "top": 290,
              "width": 880,
              "height": 170,
              "content": "<p style=\"font-size: 20px;\"><strong>Three-step answer method</strong></p><p style=\"font-size: 17px;\">1. Define the finance term precisely.</p><p style=\"font-size: 17px;\">2. Apply it to the facts of the company case.</p><p style=\"font-size: 17px;\">3. Conclude with the business consequence or decision.</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#1f2937",
              "rotate": 0
            },
            {
              "id": "text_lan110_module_03_model",
              "type": "text",
              "left": 60,
              "top": 480,
              "width": 880,
              "height": 50,
              "content": "<p style=\"font-size: 16px; text-align: center;\">Model phrase: “In this case, the key issue is..., which means the company should consider...”</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#4c1d95",
              "rotate": 0
            }
          ],
          "background": {
            "type": "solid",
