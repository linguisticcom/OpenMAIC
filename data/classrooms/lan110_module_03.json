              "type": "text",
              "left": 90,
              "top": 145,
              "width": 330,
              "height": 305,
              "content": "<p style=\"font-size: 17px;\">• capital</p><p style=\"font-size: 17px;\">• share</p><p style=\"font-size: 17px;\">• equity</p><p style=\"font-size: 17px;\">• debt</p><p style=\"font-size: 17px;\">• prospectus</p><p style=\"font-size: 17px;\">• bank loan</p><p style=\"font-size: 17px;\">• venture capital</p><p style=\"font-size: 17px;\">• claim</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#1e293b",
              "rotate": 0
            },
            {
              "id": "shape_lan110_module_03_explain_box",
              "type": "shape",
