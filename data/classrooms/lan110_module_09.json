      "id": "scene_lan110_module_09_4_quiz",
      "stageId": "lan110_module_09",
      "type": "quiz",
      "title": "Quick Check: Cash flow and funds-flow statements",
      "order": 4,
      "content": {
        "type": "quiz",
        "questions": [
          {
            "id": "q1",
            "type": "single",
            "question": "Why can a profitable company still have cash-flow problems?",
            "options": [
              {
                "value": "A",
                "label": "Profit and cash timing can differ"
              },
              {
                "value": "B",
                "label": "Profit always creates immediate cash"
              },
              {
                "value": "C",
                "label": "Suppliers never affect cash flow"
              },
              {
                "value": "D",
                "label": "Inventory has no cash impact"
              }
            ],
            "answer": [
              "A"
            ],
            "analysis": "Revenue and expenses may be recognized before cash is received or paid. Late collections, inventory, and supplier timing can create liquidity pressure.",
            "points": 10,
            "hasAnswer": true
          }
        ]
      },
      "actions": [
        {
          "id": "action_lan110_module_09_quiz_intro",
          "type": "speech",
          "text": "Now test your understanding of cash flow and funds-flow statements. Choose the answer that best fits the business situation.",
